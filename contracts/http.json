{
  "schema": "antenna.service.v1",
  "title": "HTTP document service",
  "transport": "http",
  "capabilities": [
    "object.store",
    "document.inspect"
  ],
  "graph": {
    "start": "preserve",
    "nodes": {
      "preserve": "object.store",
      "inspect": "document.inspect"
    },
    "edges": [
      [
        "preserve",
        "inspect"
      ],
      [
        "inspect",
        "END"
      ]
    ],
    "parameters": {
      "preserve": {
        "content": {
          "json_from": "input"
        },
        "content_type": "application/json"
      },
      "inspect": {
        "digest": {
          "from": "result.digest"
        }
      }
    }
  }
}
